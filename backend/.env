# ============================================================
# TASK MANAGER BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================

# ============================================================
# LLM BACKEND SELECTION
# ============================================================

# Use Ollama for local LLM (true = Ollama, false = Anthropic)
USE_OLLAMA=true

# Ollama Configuration (when USE_OLLAMA=true)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic Configuration (when USE_OLLAMA=false)
# Uncomment and set your API key to use Claude instead
# ANTHROPIC_API_KEY=sk-your-api-key-here

# ============================================================
# MCP SERVER CONFIGURATION
# ============================================================

# MCP Server URL for task tools
MCP_SERVER_URL=http://localhost:8002/sse

# ============================================================
# DEVELOPMENT SETTINGS
# ============================================================

# FastAPI settings
ENVIRONMENT=development
DEBUG=true

# ============================================================
# NOTES
# ============================================================
# 
# To switch to Anthropic Claude:
#   1. Set USE_OLLAMA=false
#   2. Add your ANTHROPIC_API_KEY=sk-...
#   3. Restart the backend
#
# Available Ollama models to try:
#   - llama3.2 (default, most capable)
#   - mistral (faster)
#   - neural-chat (fast, good for chat)
#   - orca (smaller, lighter)
#
# Load other models with:
#   ollama pull mistral
#   ollama pull neural-chat
#
# For Docker deployment, update docker-compose.yml:
#   environment:
#     - USE_OLLAMA=true
#     - OLLAMA_URL=http://ollama:11434
#     - OLLAMA_MODEL=llama3.2
#     - MCP_SERVER_URL=http://mcp_server:8002/sse
#
